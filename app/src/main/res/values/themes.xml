<resources>
    <!-- Base application theme. -->
    <style name="Theme.Whisper.NoActionBar" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:windowBackground">@color/windowBackground</item>
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/darkGrey</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/darkGrey</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="colorOnBackground">@color/textPrimary</item>
        <item name="colorOutline">@color/lightGrey</item>
    </style>

    <!-- Base application theme. -->
    <style name="Theme.Whisper.ActionBar" parent="Theme.Material3.Dark">
        <!-- Customize your light theme here. -->
        <item name="android:windowBackground">@color/windowBackground</item>
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/darkGrey</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/darkGrey</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="colorOnBackground">@color/textPrimary</item>
        <item name="colorOutline">@color/lightGrey</item>
    </style>

    <style name="Theme.WhisperFloating" parent="Theme.Whisper.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

</resources>
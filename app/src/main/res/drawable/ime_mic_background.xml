<?xml version="1.0" encoding="utf-8"?>
<!-- Mic key (idle). Rainbow GradientBorderDrawable replaces it while recording -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#22FFFFFF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape>
                    <solid android:color="@color/ime_key_pressed" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/ime_key" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

<?xml version="1.0" encoding="utf-8"?>
<!-- Toggle key (auto, backend): accent fill when activated, normal key otherwise -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#22FFFFFF">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape>
                    <solid android:color="@color/ime_accent" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/ime_key" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

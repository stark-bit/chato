<?xml version="1.0" encoding="utf-8"?>
<!-- Accent key (enter), pill shaped like FUTO's enter key -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#22000000">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape>
                    <solid android:color="@color/ime_accent_pressed" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/ime_accent" />
                    <corners android:radius="100dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

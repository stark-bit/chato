<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:importantForAutofill="noExcludeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <TextView
            style="@style/Settings.Header"
            android:paddingTop="8dp"
            android:text="@string/pref_backend" />

        <LinearLayout
            style="@style/Settings.Row"
            android:orientation="vertical"
            android:gravity="start"
            android:minHeight="0dp">
            <Spinner
                android:id="@+id/spinner_backend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-8dp" />
            <TextView
                android:id="@+id/tvBackendInfo"
                style="@style/Settings.Summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_append"
            style="@style/Settings.Row"
            android:background="?attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/Settings.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/test_append" />
                <TextView
                    style="@style/Settings.Summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/append_summary" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/mode_append"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/test_append" />
        </LinearLayout>

        <TextView
            style="@style/Settings.Header"
            android:text="@string/test_result" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/test_result_background">
            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">
                <!-- External: a TextView, not an EditText, so no keyboard (a second mic) or password manager pops up -->
                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/instructions"
                    android:textColor="@color/ime_on_key"
                    android:textColorHint="@color/ime_on_key_dim"
                    android:textSize="18sp"
                    android:textIsSelectable="true" />
            </ScrollView>
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:contentDescription="@string/copy_to_clipboard"
                android:src="@drawable/ic_copy"
                app:fabSize="mini"
                app:backgroundTint="@color/ime_accent"
                app:tint="@color/ime_on_accent" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvStatus"
            style="@style/Settings.Summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:minLines="1" />

        <ProgressBar
            android:id="@+id/processing_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:indeterminate="false"
            android:progressTint="@color/ime_accent"
            android:progressBackgroundTint="@color/ime_key"
            android:indeterminateTint="@color/ime_accent" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp">
            <ImageButton
                android:id="@+id/btnRecord"
                android:layout_width="180dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/ime_mic_background"
                android:contentDescription="@string/record_button"
                android:scaleType="center"
                android:src="@drawable/ic_mic_48dp"
                app:tint="@color/ime_on_key" />
            <ImageButton
                android:id="@+id/btnInfo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/info"
                android:src="@drawable/ic_info_48dp"
                android:scaleType="fitCenter"
                android:padding="10dp"
                app:tint="@color/ime_on_key_dim" />
        </FrameLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

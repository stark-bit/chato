<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/darkGrey"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="5dp"
    android:paddingTop="5dp"
    android:paddingBottom="0dp">

    <!-- Top row: collapsible via btnToolbarToggle -->
    <LinearLayout
        android:id="@+id/layout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="5dp"
        android:layout_marginTop="2dp">

        <ImageButton
            android:id="@+id/btnModeAuto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_toggle_background"
            android:src="@drawable/ic_ime_auto"
            android:tint="@color/ime_toolbar_icon_tint"
            android:contentDescription="@string/auto_button"/>
        <ImageButton
            android:id="@+id/btnDash"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:paddingHorizontal="2dp"
            android:paddingVertical="9dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_key_background"
            android:src="@drawable/ic_ime_dash"
            android:contentDescription="@string/dash_button"/>
        <ImageButton
            android:id="@+id/btnDot"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:paddingHorizontal="2dp"
            android:paddingVertical="9dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_key_background"
            android:src="@drawable/ic_ime_dot"
            android:contentDescription="@string/dot_button"/>
        <ImageButton
            android:id="@+id/btnSpace"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="2"
            android:layout_margin="3dp"
            android:paddingHorizontal="2dp"
            android:paddingVertical="9dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_key_background"
            android:src="@drawable/ic_ime_space"
            android:contentDescription="@string/space_button"/>
        <ImageButton
            android:id="@+id/btnBackend"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_toggle_background"
            android:src="@drawable/ic_ime_cloud"
            android:tint="@color/ime_toolbar_icon_tint"
            android:contentDescription="@string/backend_toggle"/>

    </LinearLayout>
    <TextView
        android:id="@+id/tv_status"
        android:visibility="gone"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:textSize="20dp"
        android:textColor="@android:color/holo_red_dark" />
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginHorizontal="5dp"
        android:layout_marginBottom="2dp">

        <ImageButton
            android:id="@+id/btnKeyboard"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.5"
            android:layout_margin="3dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_key_background"
            android:src="@drawable/ic_keyboard_36dp"
            android:contentDescription="@string/exit_button"/>
        <ImageButton
            android:id="@+id/btnToolbarToggle"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.5"
            android:layout_margin="3dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="13dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_key_background"
            android:src="@drawable/ic_ime_expand"
            android:contentDescription="@string/toolbar_toggle_button"/>
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="3"
            android:layout_margin="3dp"
            android:paddingHorizontal="4dp" android:paddingVertical="10dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_mic_background"
            android:src="@drawable/ic_mic_48dp"
            android:contentDescription="@string/record_button"/>
        <ImageButton
            android:id="@+id/btnDel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.5"
            android:layout_margin="3dp"
            android:paddingHorizontal="4dp" android:paddingVertical="13dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_key_background"
            android:src="@drawable/ic_keyboard_del_48dp"
            android:contentDescription="@string/delete_button"/>
        <ImageButton
            android:id="@+id/btnEnter"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.5"
            android:layout_margin="3dp"
            android:paddingHorizontal="4dp" android:paddingVertical="13dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_key_background"
            android:src="@drawable/ic_keyboard_return_48dp"
            android:contentDescription="@string/return_button"/>

    </LinearLayout>

</LinearLayout>

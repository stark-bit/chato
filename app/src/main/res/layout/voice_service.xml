<?xml version="1.0" encoding="utf-8"?>
<!-- Compact IME layout styled after FUTO keyboard -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/ime_bg"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="2dp"
    android:paddingTop="3dp"
    android:paddingBottom="2dp">

    <!-- Top row: collapsible via btnToolbarToggle -->
    <LinearLayout
        android:id="@+id/layout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnDash"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="3dp"
            android:paddingHorizontal="2dp"
            android:paddingVertical="10dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_key_background"
            android:src="@drawable/ic_ime_dash"
            android:tint="@color/ime_on_key"
            android:contentDescription="@string/dash_button"/>
        <ImageButton
            android:id="@+id/btnDot"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="3dp"
            android:paddingHorizontal="2dp"
            android:paddingVertical="10dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_key_background"
            android:src="@drawable/ic_ime_dot"
            android:tint="@color/ime_on_key"
            android:contentDescription="@string/dot_button"/>
        <ImageButton
            android:id="@+id/btnSpace"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="3"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="3dp"
            android:paddingHorizontal="2dp"
            android:paddingVertical="10dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_key_background"
            android:src="@drawable/ic_ime_space"
            android:tint="@color/ime_on_key"
            android:contentDescription="@string/space_button"/>
        <ImageButton
            android:id="@+id/btnBackend"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="3dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_toggle_background"
            android:src="@drawable/ic_ime_cloud"
            android:tint="@color/ime_toolbar_icon_tint"
            android:contentDescription="@string/backend_toggle"/>

    </LinearLayout>
    <TextView
        android:id="@+id/tv_status"
        android:visibility="gone"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingVertical="2dp"
        android:textSize="14sp"
        android:textColor="@color/ime_error" />
    <!-- Main row: toggle | auto | mic | delete | enter | keyboard switch -->
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnToolbarToggle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="3dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="10dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_key_background"
            android:src="@drawable/ic_ime_expand"
            android:tint="@color/ime_on_key"
            android:contentDescription="@string/toolbar_toggle_button"/>
        <ImageButton
            android:id="@+id/btnModeAuto"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="3dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="9dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_toggle_background"
            android:src="@drawable/ic_ime_auto"
            android:tint="@color/ime_toolbar_icon_tint"
            android:contentDescription="@string/auto_button"/>
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="2.5"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="3dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="7dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_mic_background"
            android:src="@drawable/ic_mic_48dp"
            android:tint="@color/ime_on_key"
            android:contentDescription="@string/record_button"/>
        <ImageButton
            android:id="@+id/btnDel"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.25"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="3dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="9dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_key_background"
            android:src="@drawable/ic_keyboard_del_48dp"
            android:tint="@color/ime_on_key"
            android:contentDescription="@string/delete_button"/>
        <ImageButton
            android:id="@+id/btnEnter"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.25"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="3dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="9dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_accent_background"
            android:src="@drawable/ic_keyboard_return_48dp"
            android:tint="@color/ime_on_accent"
            android:contentDescription="@string/return_button"/>
        <ImageButton
            android:id="@+id/btnKeyboard"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="3dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="10dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ime_key_background"
            android:src="@drawable/ic_keyboard_36dp"
            android:tint="@color/ime_on_key"
            android:contentDescription="@string/exit_button"/>

    </LinearLayout>

</LinearLayout>

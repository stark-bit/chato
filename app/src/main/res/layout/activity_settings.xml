<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ime_bg"
    android:fitsSystemWindows="true">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/row_test_transcription"
                style="@style/Settings.Row"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="20dp"
                    android:src="@drawable/ic_mic_48dp"
                    android:importantForAccessibility="no"
                    app:tint="@color/ime_accent" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Settings.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_test_title" />
                    <TextView
                        style="@style/Settings.Summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_test_summary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Settings.Header"
                android:paddingTop="8dp"
                android:text="@string/pref_backend" />

            <LinearLayout style="@style/Settings.Row">
                <Spinner
                    android:id="@+id/spinner_backend_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_openai_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Settings.Field"
                    android:hint="@string/settings_openai_endpoint">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_openai_endpoint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Settings.Field"
                    android:hint="@string/settings_openai_api_key"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_openai_api_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Settings.Field"
                    android:hint="@string/settings_openai_model">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_openai_model"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                style="@style/Settings.Header"
                android:text="@string/settings_endpoints" />
            <TextView
                style="@style/Settings.Summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="20dp"
                android:text="@string/settings_endpoints_help" />
            <LinearLayout
                android:id="@+id/layout_endpoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Settings.Header"
                android:text="@string/quick_record" />
            <TextView
                style="@style/Settings.Summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:text="@string/settings_quick_record_help" />
            <LinearLayout style="@style/Settings.Row">
                <TextView
                    style="@style/Settings.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="@string/settings_quick_record_endpoint" />
                <Spinner
                    android:id="@+id/spinner_quick_record_endpoint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/row_assistant"
                style="@style/Settings.Row"
                android:orientation="vertical"
                android:gravity="start|center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    style="@style/Settings.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_assistant_title" />
                <TextView
                    style="@style/Settings.Summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_assistant_summary" />
            </LinearLayout>

            <TextView
                style="@style/Settings.Header"
                android:text="@string/settings_general" />

            <LinearLayout
                style="@style/Settings.Row"
                android:orientation="vertical"
                android:gravity="start">
                <TextView
                    style="@style/Settings.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_minimum_silence" />
                <TextView
                    style="@style/Settings.Summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_min_silence_summary" />
                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/settings_min_silence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-12dp"
                    android:valueFrom="0"
                    android:valueTo="3000"
                    android:stepSize="100" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_mode_bluetooth"
                style="@style/Settings.Row"
                android:background="?attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Settings.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_bluetooth" />
                    <TextView
                        style="@style/Settings.Summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_bluetooth_summary" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/mode_bluetooth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/setting_bluetooth"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

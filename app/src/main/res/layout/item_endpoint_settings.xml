<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/endpoint_title"
        style="@style/Settings.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Settings.Field"
        android:hint="@string/endpoint_name">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_endpoint_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Settings.Field"
        android:hint="@string/endpoint_url">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_endpoint_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Settings.Field"
        android:hint="@string/endpoint_headers">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_endpoint_headers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="1"
            android:textSize="14sp"
            android:typeface="monospace" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Settings.Field"
        android:hint="@string/endpoint_body"
        app:helperText="@string/endpoint_body_help">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_endpoint_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="2"
            android:textSize="14sp"
            android:typeface="monospace" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/row_endpoint_combine"
        style="@style/Settings.Row"
        android:background="?attr/selectableItemBackground">
        <TextView
            style="@style/Settings.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:text="@string/endpoint_combine" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/check_endpoint_combine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/endpoint_combine" />
    </LinearLayout>
</LinearLayout>

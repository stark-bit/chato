<?xml version="1.0"?>
<!DOCTYPE import-control PUBLIC "-//Checkstyle//DTD ImportControl Configuration 1.4//EN"
        "https://checkstyle.org/dtds/import_control_1_4.dtd">
<import-control pkg="com.whisperonnx" strategyOnMismatch="allowed">

    <subpackage name="keyboard">
        <disallow pkg="com\.whisperonnx\.(quickrecord|voiceinput|testscreen|setup|settings|thirdparty)" regex="true"/>
    </subpackage>
    <subpackage name="quickrecord">
        <disallow pkg="com\.whisperonnx\.(keyboard|voiceinput|testscreen|setup|settings|thirdparty)" regex="true"/>
    </subpackage>
    <subpackage name="voiceinput">
        <disallow pkg="com\.whisperonnx\.(keyboard|quickrecord|testscreen|setup|settings|thirdparty)" regex="true"/>
    </subpackage>
    <subpackage name="testscreen">
        <disallow pkg="com\.whisperonnx\.(keyboard|quickrecord|voiceinput|setup|settings|thirdparty)" regex="true"/>
    </subpackage>
    <subpackage name="setup">
        <disallow pkg="com\.whisperonnx\.(keyboard|quickrecord|voiceinput|testscreen|settings|thirdparty)" regex="true"/>
    </subpackage>
    <subpackage name="settings">
        <disallow pkg="com\.whisperonnx\.(keyboard|quickrecord|voiceinput|testscreen|setup|thirdparty)" regex="true"/>
    </subpackage>

    <subpackage name="ui">
        <disallow pkg="com\.whisperonnx\.(keyboard|quickrecord|voiceinput|testscreen|setup|settings|thirdparty)" regex="true"/>
    </subpackage>

    <subpackage name="backend">
        <disallow pkg="com\.whisperonnx\.(keyboard|quickrecord|voiceinput|testscreen|setup|settings|ui)" regex="true"/>
        <disallow class="com.whisperonnx.R"/>
        <disallow pkg="android\.(widget|view|app)" regex="true"/>
        <disallow pkg="androidx.appcompat"/>
        <disallow pkg="com.google.android.material"/>
    </subpackage>
    <subpackage name="recording">
        <disallow pkg="com\.whisperonnx\.(keyboard|quickrecord|voiceinput|testscreen|setup|settings|ui|thirdparty)" regex="true"/>
        <disallow class="com.whisperonnx.R"/>
        <disallow pkg="android\.(widget|view|app)" regex="true"/>
        <disallow pkg="androidx.appcompat"/>
        <disallow pkg="com.google.android.material"/>
    </subpackage>
    <subpackage name="endpoint">
        <disallow pkg="com\.whisperonnx\.(keyboard|quickrecord|voiceinput|testscreen|setup|settings|ui|thirdparty)" regex="true"/>
        <disallow class="com.whisperonnx.R"/>
        <disallow pkg="android\.(widget|view|app)" regex="true"/>
        <disallow pkg="androidx.appcompat"/>
        <disallow pkg="com.google.android.material"/>
    </subpackage>

    <subpackage name="prefs">
        <disallow pkg="com\.whisperonnx\.(?!prefs)\w+" regex="true"/>
        <disallow class="com.whisperonnx.R"/>
    </subpackage>

    <subpackage name="thirdparty">
        <allow pkg="com.whisperonnx.thirdparty"/>
        <disallow pkg="com.whisperonnx"/>
    </subpackage>
</import-control>
